# Parakeet weights are downloaded and bundled during the build; do not commit model binaries.
app/src/main/assets/models/*.bin
!app/src/main/assets/models/.gitkeep

# Release signing identity: never commit private keys or passwords.
keystore.properties
*.jks
*.keystore

# Build-downloaded local LLM weights
core-llm/src/main/assets/models/*.gguf
